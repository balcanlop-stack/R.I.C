<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ric.ric.profesor.controller.GruposController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <VBox spacing="4.0">
         <children>
            <Label text="Mis grupos">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            <Label text="Consulta académica del profesor" textFill="#666666" />
         </children>
      </VBox>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Seleccionar grupo:">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <ComboBox fx:id="cmbGrupos" prefWidth="180.0" promptText="Elige un grupo" />
         </children>
      </HBox>
      <Label text="Lista de alumnos">
         <font>
            <Font name="System Bold" size="15.0" />
         </font>
      </Label>
      <TableView fx:id="tblAlumnos" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colMatricula" prefWidth="150.0" text="Matrícula" />
          <TableColumn fx:id="colNombre" prefWidth="350.0" text="Alumno" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>