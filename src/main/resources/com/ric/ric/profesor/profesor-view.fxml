<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane"  
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.ric.ric.profesor.controller.ProfesorController"
    styleClass="root">

    <!-- MENU LATERAL -->
    <left>
        <VBox prefWidth="245" styleClass="sidebar" spacing="15">

            <padding>
                <Insets top="30" right="18" bottom="25" left="18"/>
            </padding>

            <VBox spacing="5">
                <Label text="R.I.C." styleClass="logo"/>
                <Label text="REGISTRO INTEGRAL"
                       styleClass="logo-subtitle"/>
                <Label text="DE CALIFICACIONES"
                       styleClass="logo-subtitle"/>
            </VBox>

            <Label text="MENÚ PRINCIPAL"
                   styleClass="menu-title"/>

            <Button text="⌂    Inicio"
                    onAction="#mostrarInicio"
                    styleClass="menu-button"
                    maxWidth="Infinity"/>

            <Button text="♙    Mis grupos"
                    onAction="#mostrarGrupos"
                    styleClass="menu-button"
                    maxWidth="Infinity"/>

            <Button text="▤    Mis materias"
                    onAction="#mostrarMaterias"
                    styleClass="menu-button"
                    maxWidth="Infinity"/>

            <Button text="⚙    Criterios de evaluación"
                    onAction="#mostrarCriterios"
                    styleClass="menu-button"
                    maxWidth="Infinity"/>

            <Button text="▣    Actividades"
                    onAction="#mostrarActividades"
                    styleClass="menu-button"
                    maxWidth="Infinity"/>

            <Button text="✎    Calificaciones"
                    onAction="#mostrarCalificaciones"
                    styleClass="menu-button"
                    maxWidth="Infinity"/>

            <Button text="✉    Solicitudes"
                    onAction="#mostrarSolicitudes"
                    styleClass="menu-button"
                    maxWidth="Infinity"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Button text="↪    Cerrar sesión"
                    onAction="#cerrarSesion"
                    styleClass="logout-button"
                    maxWidth="Infinity"/>

        </VBox>
    </left>

    <!-- CONTENIDO PRINCIPAL -->
    <center>
        <VBox fx:id="vistaInicio" spacing="25" styleClass="main-content">

            <padding>
                <Insets top="30" right="35" bottom="30" left="35"/>
            </padding>

            <!-- ENCABEZADO -->
            <HBox alignment="CENTER_LEFT" spacing="15">

                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Panel del Profesor"
                           styleClass="page-title"/>

                    <Label text="Bienvenido al sistema R.I.C."
                           styleClass="page-subtitle"/>
                </VBox>

                <VBox alignment="CENTER_RIGHT" spacing="5">
                    <Label fx:id="nombreProfesor"
                           text="Profesor"
                           styleClass="teacher-name"/>

                    <Label fx:id="fechaActual"
                           text="Gestión académica"
                           styleClass="teacher-role"/>
                </VBox>

            </HBox>

            <!-- BIENVENIDA -->
            <VBox styleClass="welcome-card" spacing="8">
                <Label text="¡Bienvenido al sistema!"
                       styleClass="welcome-title"/>

                <Label text="Desde aquí podrás gestionar tus grupos, materias y calificaciones."
                       styleClass="welcome-description"/>
            </VBox>

            <!-- RESUMEN -->
            <VBox spacing="15">

                <Label text="Resumen académico"
                       styleClass="section-title"/>

                <GridPane hgap="18" vgap="18">

                    <VBox GridPane.columnIndex="0"
                          GridPane.rowIndex="0"
                          styleClass="stat-card">

                        <Label text="♙" styleClass="stat-icon"/>
                        <Label text="Mis grupos"
                               styleClass="stat-title"/>
                        <Label text="Por consultar"
                               styleClass="stat-value"/>

                    </VBox>

                    <VBox GridPane.columnIndex="1"
                          GridPane.rowIndex="0"
                          styleClass="stat-card">

                        <Label text="▤" styleClass="stat-icon"/>
                        <Label text="Mis materias"
                               styleClass="stat-title"/>
                        <Label text="Por consultar"
                               styleClass="stat-value"/>

                    </VBox>

                    <VBox GridPane.columnIndex="0"
                          GridPane.rowIndex="1"
                          styleClass="stat-card">

                        <Label text="✎" styleClass="stat-icon"/>
                        <Label text="Calificaciones"
                               styleClass="stat-title"/>
                        <Label text="Por registrar"
                               styleClass="stat-value"/>

                    </VBox>

                    <VBox GridPane.columnIndex="1"
                          GridPane.rowIndex="1"
                          styleClass="stat-card">

                        <Label text="✉" styleClass="stat-icon"/>
                        <Label text="Solicitudes"
                               styleClass="stat-title"/>
                        <Label text="Por revisar"
                               styleClass="stat-value"/>

                    </VBox>

                </GridPane>

            </VBox>

            <!-- ACCESOS -->
            <VBox spacing="12">

                <Label text="Accesos rápidos"
                       styleClass="section-title"/>

                <HBox spacing="15">

                    <Button text="Consultar grupos"
                            onAction="#mostrarGrupos"
                            styleClass="primary-button"/>

                    <Button text="Registrar calificaciones"
                            onAction="#mostrarCalificaciones"
                            styleClass="primary-button"/>

                </HBox>

            </VBox>

            <VBox VBox.vgrow="ALWAYS"/>

            <Label text="R.I.C. | Registro Integral de Calificaciones"
                   styleClass="footer-text"/>

        </VBox>
    </center>

</BorderPane>
